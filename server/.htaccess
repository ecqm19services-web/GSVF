Options -Indexes

RewriteEngine On

# Force trailing slash on /api directories for cleaner routing
RewriteCond %{REQUEST_URI} ^/api/[a-z0-9_-]+$ [NC]
RewriteRule ^(.*)$ /$1/ [R=301,L]

# Let API requests pass directly to their folders
RewriteRule ^api/ - [L]

# Block direct access to server backup archives
RewriteRule ^backups/ - [F,L]

# Block direct access to server logs
RewriteRule ^logs/ - [F,L]

# Block direct access to live user data (contacts/admissions)
RewriteRule ^data/ - [F,L]

# Do not rewrite existing files/folders
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallback
RewriteRule ^ index.html [L]

# Headers de sécurité
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
