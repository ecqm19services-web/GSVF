# Configuration Appwrite
# Créez un fichier .env avec vos valeurs

VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_project_id_here
VITE_APPWRITE_DATABASE_ID=school_db

# Variables pour les Netlify Functions (serveur) - à configurer aussi dans Netlify
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id_here
APPWRITE_DATABASE_ID=school_db
APPWRITE_API_KEY=your_api_key_here

# Optionnel: seulement si l'ID de la collection n'est pas "site_pages"
APPWRITE_SITE_PAGES_COLLECTION_ID=site_pages

# Mot de passe admin (hashé en production)
VITE_ADMIN_PASSWORD=votre_mot_de_passe_ici
