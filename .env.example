# Configuration Appwrite (côté client)
# Créez un fichier .env avec vos valeurs

VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_project_id_here
VITE_APPWRITE_DATABASE_ID=school_db

# Configuration serveur (dans dist/_secure/appwrite-config.php sur Hostinger)
# APPWRITE_ENDPOINT, APPWRITE_PROJECT_ID, APPWRITE_API_KEY, etc.

# Mot de passe admin (hashé en production via dist/_secure/.htpasswd)
VITE_ADMIN_PASSWORD=votre_mot_de_passe_ici
